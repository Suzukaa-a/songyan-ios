    "keyboardTools.editor.step.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$d 步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$d 步"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ %1$d"
          }
        }
      }
    },
