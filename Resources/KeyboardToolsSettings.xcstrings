    "keyboardTools.editor.width": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全角半角"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全形半形"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全角と半角"
          }
        }
      }
    },
    "keyboardTools.empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールはまだありません。"
          }
        }
      }
    },
    "keyboardTools.error.builtinNotDeletable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置工具不能删除，可以复制一份再修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建工具不能刪除，可以複製一份再修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵のツールは削除できません。複製してから編集してください。"
          }
        }
      }
    },
    "keyboardTools.error.export": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出失败，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出失敗，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出せませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "keyboardTools.error.generic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作没有完成，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作沒有完成，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を完了できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "keyboardTools.error.identifierReserved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件用的名称和内置工具重复，请换一个文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案用的名稱和內建工具重複，請換一個檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは内蔵ツールと同じ名前を使っています。別のファイルを選んでください。"
          }
        }
      }
    },
    "keyboardTools.error.importFile": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取所选文件，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取所選檔案，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルを読み取れません。別のファイルを選んでください。"
          }
        }
      }
    },
    "keyboardTools.error.mapLine": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$d 步的对照表第 %2$d 行写得不对，请写成「原字=新字」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$d 步的對照表第 %2$d 行寫得不對，請寫成「原字=新字」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 番目のステップの対応表 %2$d 行目が正しくありません。「元の文字=新しい文字」の形で書いてください。"
          }
        }
      }
    },
    "keyboardTools.error.metadataUnavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具设置读不出来，可能是文件损坏。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具設定讀不出來，可能是檔案損壞。請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールの設定を読み取れません。ファイルが壊れている可能性があります。もう一度お試しください。"
          }
        }
      }
    },
    "keyboardTools.error.nameMissing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请给工具起一个名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請給工具起一個名字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールに名前を付けてください。"
          }
        }
      }
    },
    "keyboardTools.error.noUndo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可以撤销的删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可以撤銷的刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻せる削除はありません。"
          }
        }
      }
    },
    "keyboardTools.error.notReady": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时读不到工具，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時讀不到工具，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールを読み込めません。もう一度お試しください。"
          }
        }
      }
    },
    "keyboardTools.error.pinLimit": {
      "localizations": {
        "zh-Hans": {
