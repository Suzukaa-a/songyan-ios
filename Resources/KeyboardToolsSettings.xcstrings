    "keyboardTools.action.undoNamed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销删除「%1$@」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷刪除「%1$@」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」の削除を元に戻す"
          }
        }
      }
    },
    "keyboardTools.action.unpin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从工具栏取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從工具欄取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーから外す"
          }
        }
      }
    },
    "keyboardTools.case.capitalize": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个词首字母大写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個詞首字母大寫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各単語の先頭を大文字"
          }
        }
      }
    },
    "keyboardTools.case.lower": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部小写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部小寫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて小文字"
          }
        }
      }
    },
    "keyboardTools.case.upper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部大写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部大寫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて大文字"
          }
        }
      }
    },
    "keyboardTools.delete.confirmMessage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后可以撤销一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後可以撤銷一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したあと、一度だけ元に戻せます。"
          }
        }
      }
    },
    "keyboardTools.delete.confirmTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除工具「%1$@」？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除工具「%1$@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を削除しますか？"
          }
        }
      }
    },
    "keyboardTools.editor.case": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大小寫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字と小文字"
          }
        }
      }
    },
    "keyboardTools.editor.hint.map": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一行一对，写成「原字=新字」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一行一對，寫成「原字=新字」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に 1 組、「元の文字=新しい文字」の形で書きます。"
          }
        }
      }
    },
    "keyboardTools.editor.hint.replace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「查找」是正则表达式，「替换为」可以用 $1 引用括号里的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「查詢」是正則表示式，「取代為」可以用 $1 引用括號裡的內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「検索」は正規表現です。「置換後」では $1 で括弧の中身を参照できます。"
          }
        }
      }
    },
    "keyboardTools.editor.hint.template": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 {text} 表示原来的文字，例如「{text}」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 {text} 表示原來的文字，例如「{text}」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} が元の文字に置き換わります。たとえば「{text}」。"
          }
        }
      }
    },
    "keyboardTools.editor.map": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对照表"
