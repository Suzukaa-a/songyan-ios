        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキスト"
          }
        }
      }
    },
    "tools.source.paragraph": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标前的段落"
