          }
        }
      }
    },
    "tools.source.clipboard": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード"
          }
        }
      }
    },
    "tools.source.unavailable.selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有选中的文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有選中的文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストがありません"
          }
        }
      }
    },
    "tools.source.unavailable.paragraph": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标前没有文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標前沒有文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソル前にテキストがありません"
          }
        }
      }
    },
    "tools.source.unavailable.clipboard": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板没有文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿沒有文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにテキストがありません"
          }
        }
      }
    },
    "tools.list.header": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール"
          }
        }
      }
    },
    "tools.list.empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用的工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使えるツールがありません"
          }
        }
      }
    },
    "tools.list.unreadable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能读取工具列表，请在「松烟」中检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能讀取工具列表，請在「松煙」中檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール一覧を読み取れませんでした。「松煙」で確認してください。"
          }
        }
      }
    },
    "tools.result.header": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果"
          }
        }
      }
    },
    "tools.action.replace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換え"
          }
        }
      }
    },
    "tools.action.insert": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "插入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "挿入"
          }
        }
      }
    },
    "tools.action.copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー"
          }
        }
      }
    },
    "tools.notice.copied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました"
          }
        }
      }
    },
    "tools.notice.copyFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能复制，请在「松烟」中允许完全访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能複製，請在「松煙」中允許完整取用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーできませんでした。「松煙」でフルアクセスを許可してください。"
          }
        }
      }
    },
    "tools.notice.textChanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文已改变，请点「插入」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原文已改變，請點「插入」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のテキストが変わったため、「挿入」を選んでください。"
          }
        }
      }
    },
    "tools.notice.writeFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能写入输入框，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能寫入輸入框，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄に書き込めませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "tools.error.conversionUnavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这件工具需要转换数据，当前键盘读不到，请在「松烟」中重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這件工具需要轉換資料，當前鍵盤讀不到，請在「松煙」中重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツールには変換データが必要ですが、キーボードから読み取れません。「松煙」で再試行してください。"
          }
        }
      }
    },
    "tools.error.outputTooLong": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果太长，请缩短原文后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果太長，請縮短原文後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が長すぎます。元のテキストを短くしてください。"
          }
        }
      }
    },
    "tools.error.generic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能完成处理，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能完成處理，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理を完了できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "tools.panel.noInput": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可处理的文字。可以先选中文字，或改用剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可處理的文字。可以先選中文字，或改用剪貼簿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理できるテキストがありません。テキストを選択するか、クリップボードを使ってください。"
          }
        }
      }
    },
    "tools.panel.protected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个输入框不能使用工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個輸入框不能使用工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力欄ではツールを使えません。"
          }
        }
      }
    },
    "tools.toolbar.button": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール"
          }
        }
      }
    },
    "tools.toolbar.pinnedHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具面板中打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具面板中開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールパネルで開く"
          }
        }
      }
    },
    "tools.manage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールを管理"
          }
        }
      }
    },
    "tools.manage.hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开松烟 App 的键盘工具页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟松煙 App 的鍵盤工具頁"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「松煙」のキーボードツール画面を開きます"
          }
        }
      }
    },
    "tools.result.truncated.selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中的文字较多，只处理前 1000 字，可插入或复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選中的文字較多，只處理前 1000 字，可插入或複製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストが長いため、先頭の 1000 文字だけを処理します。挿入かコピーを使えます。"
          }
        }
      }
    },
    "tools.result.truncated.paragraph": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只处理光标前最多 1000 字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只處理游標前最多 1000 字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソル前の最大 1000 文字を処理します。"
          }
        }
      }
    },
    "tools.result.truncated.clipboard": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板内容较多，只处理前 1000 字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿內容較多，只處理前 1000 字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの内容が長いため、先頭の 1000 文字だけを処理します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}