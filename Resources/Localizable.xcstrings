    "scheme.archive.conflict.format": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」在「%2$@」与「%3$@」中内容不同，请只保留其中一个压缩包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」在「%2$@」與「%3$@」中內容不同，請只保留其中一個壓縮檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」の内容が「%2$@」と「%3$@」で異なります。どちらか一方の ZIP ファイルを選んでください。"
          }
        }
      }
    },
    "catalog.checksumFailure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的文件校验失败，请重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的檔案驗證失敗，請重新下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルを確認できませんでした。もう一度ダウンロードしてください。"
          }
        }
      }
    },
    "catalog.incompleteDownload": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的文件不完整，请重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的檔案不完整，請重新下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルが不足しています。もう一度ダウンロードしてください。"
          }
        }
      }
    },
    "catalog.missingInputMethod": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的方案缺少输入方式，请重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的方案缺少輸入方式，請重新下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルに入力方式がありません。もう一度ダウンロードしてください。"
          }
        }
      }
    },
    "catalog.archiveBudget": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件总大小超过限制，请重新选择或下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案總大小超過限制，請重新選擇或下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの合計サイズが上限を超えています。選び直すか、もう一度ダウンロードしてください。"
          }
        }
      }
    },
    "catalog.schemaListConflict": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个输入方案会改动输入方式列表，和推荐目录不一致，请重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個輸入方案會改動輸入方式列表，和推薦目錄不一致，請重新下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力方式の内容がおすすめ一覧の入力方式と一致しません。もう一度ダウンロードしてください。"
          }
        }
      }
    },
    "catalog.schemaListUnreadable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核对这个输入方案的输入方式列表，请重新下载。"
