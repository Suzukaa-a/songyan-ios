+bool ResourceResolver::IsSafeResourceId(const string& resource_id) {
+  if (resource_id.find('\\') != string::npos ||
+      resource_id.find('\0') != string::npos ||
+      boost::starts_with(resource_id, "/")) {
+    return false;
+  }
+  vector<string> components;
+  boost::split(components, resource_id, boost::is_any_of("/"));
+  for (const auto& component : components) {
+    if (component == "..")
+      return false;
+  }
+  return true;
+}
+
+// Ids come from configuration (user_dict, dictionary, __include ...), so an
+// absolute or parent-relative id would make the engine read or write outside
+// its data folders. A refused id resolves under a folder that no valid id can
+// name and nothing creates, so lookups fail as if the resource were missing
+// and writes fail instead of escaping.
+path ResourceResolver::RefusedPath(const string& resource_id) const {
+  LOG(ERROR) << "refused " << type_.name << " resource id '" << resource_id
+             << "': it leaves the data folder.";
+  return std::filesystem::absolute(root_path_ / "\\refused-resource-id\\" /
+                                   "missing");
+}
+
 path ResourceResolver::ResolvePath(const string& resource_id) {
+  if (!IsSafeResourceId(resource_id))
+    return RefusedPath(resource_id);
   return std::filesystem::absolute(root_path_ /
                                    (type_.prefix + resource_id + type_.suffix));
 }
 
