    "core.term.readFailureWithRetry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取当前选择，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取當前選擇，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の選択を読み取れませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "core.term.genericOperationFailure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成，请重试。"
