          }
        }
      }
    },
    "core.term.userKeyboardEmptyHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个输入方案没有可用的键盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個輸入方案沒有可用的鍵盤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力パックで使えるキーボードがありません。"
          }
        }
      }
    },
    "core.term.userKeyboardSwitcherEmpty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未添加键盘 · 请在松烟 App 的「我的键盘」中添加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未新增鍵盤 · 請在松煙 App 的「我的鍵盤」中新增"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードがまだありません。松煙 App の「マイキーボード」で追加してください。"
          }
        }
      }
    },
    "core.term.userKeyboardReadOnlyNotice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里暂时无法修改。请在「输入方案」中打开方案，再从它的「我的键盘」添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡暫時無法修改。請在「輸入方案」中開啟方案，再從它的「我的鍵盤」新增。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは変更できません。「入力パック」でパックを開き、その「マイキーボード」から追加してください。"
          }
        }
      }
    },
    "core.term.userKeyboardNoSource": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘还没有使用任何输入方案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤還沒有使用任何輸入方案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードはまだ入力パックを使用していません。"
          }
        }
      }
    },
    "core.term.userKeyboardHowToStart": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「%1$@」中打开要用的方案，在它的「%2$@」里轻点「%3$@」；没有「%2$@」的方案，直接轻点「%3$@」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「%1$@」中開啟要用的方案，在它的「%2$@」裡點一下「%3$@」；沒有「%2$@」的方案，直接點一下「%3$@」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」で使う入力パックを開き、その「%2$@」で「%3$@」をタップしてください。「%2$@」がない入力パックでは、「%3$@」を直接タップします。"
          }
        }
      }
    },
    "core.term.userKeyboardFootnote": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选后轻点「保存」加入键盘，长按%1$@可切换；轻点「%2$@」立即换用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選後點一下「儲存」加入鍵盤，長按%1$@可切換；點一下「%2$@」立即換用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックして「保存」をタップするとキーボードに追加されます。%1$@を長押しすると切り替えられ、「%2$@」をタップするとすぐに使えます。"
          }
        }
      }
    },
    "core.term.userKeyboardSaving": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存键盘…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存鍵盤…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードを保存しています…"
          }
        }
      }
    },
    "core.term.userKeyboardSaveNeedsOne": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少打开一个键盘才能保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少開啟一個鍵盤才能儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードを 1 つ以上オンにしてから保存してください。"
          }
        }
      }
    },
