    "core.term.layoutUnavailableReason": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此输入方式暂不支持「%1$@」，请改用其他%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此輸入方式暫不支援「%1$@」，請改用其他%2$@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力方式は「%1$@」に対応していません。別の%2$@を選んでください。"
          }
        }
      }
    },
    "core.term.addUserKeyboard": {
      "localizations": {
        "zh-Hans": {
