    "dependencies.error.indexTruncated": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式ソースのファイル一覧が途中で切れています：%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方源文件索引被截断：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "官方原始檔索引被截斷：%1$@"
          }
        }
      }
    },
    "dependencies.error.noUniqueProvider": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存ファイル %1$@ の公式な提供元が 1 つに定まりません。このファイルを提供するリポジトリを、ソース一覧に明示的に追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依赖项 %1$@ 没有唯一可用的官方来源；请在来源列表中明确添加提供该文件的仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依賴項 %1$@ 沒有唯一可用的官方來源；請在來源列表中明確新增提供該檔案的倉庫。"
          }
        }
      }
    },
    "dependencies.error.tooDeep": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力パックの依存関係が深すぎます（16 階層を超えています）。循環していないか確認してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方案依赖层级过多（超过 16 层）；请检查是否存在循环依赖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入方案依賴層級過多（超過 16 層）；請檢查是否存在迴圈依賴"
          }
        }
      }
    },
