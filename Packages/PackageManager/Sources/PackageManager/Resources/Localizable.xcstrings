        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方案編譯檔案解析失敗：%1$@：%2$@"
          }
        }
      }
    },
    "adapter.error.missingGenerator": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力パックに既定のメイン変換器がないため、自動適合できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方案缺少默认主转换器，无法自动适配"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入方案缺少預設主轉換器，無法自動適配"
          }
        }
      }
    },
    "adapter.error.notPinyinOrShuangpin": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力パックは自動適合できるピンイン／双拼の設定ではありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方案不是可自动适配的拼音或双拼配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入方案不是可自動適配的拼音或雙拼配置"
          }
        }
      }
    },
    "adapter.error.notTable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力パックは自動適合できるテーブル形式の設定ではありません"
          }
