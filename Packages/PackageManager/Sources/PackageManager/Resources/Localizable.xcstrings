        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "码表适配方案缺少必要数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "碼錶適配方案缺少必要資料"
          }
        }
      }
