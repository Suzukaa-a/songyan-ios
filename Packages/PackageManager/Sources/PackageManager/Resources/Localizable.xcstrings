{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "adapter.error.alphabetUnfit": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力パックの字母表をコンパクトなキーボード配置に合わせられません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方案的字母表无法适配紧凑键盘布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入方案的字母表無法適配緊湊鍵盤配置"
          }
        }
      }
    },
    "adapter.error.cannotCheckRecognizer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "識別ルールを確認できません：%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查识别规则：%1$@"
