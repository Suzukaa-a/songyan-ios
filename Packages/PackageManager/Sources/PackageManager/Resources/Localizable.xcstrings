        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方案編譯檔案超過大小限制：%1$@（%2$ld 位元組）"
          }
        }
      }
    },
    "adapter.error.compiledUnreadable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル済みの入力パックファイルを解析できません：%1$@：%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案编译文件解析失败：%1$@：%2$@"
