        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方案不是可自动适配的码表配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入方案不是可自動適配的碼錶配置"
          }
        }
      }
    },
    "adapter.error.rereadForDisplay": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示機能を追加するため入力パックを読み直せません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新读取输入方案以添加展示能力"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新讀取輸入方案以新增展示能力"
          }
        }
      }
    },
    "adapter.error.tableMissingData": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーブル形式の自動適合に必要なデータがありません"
          }
