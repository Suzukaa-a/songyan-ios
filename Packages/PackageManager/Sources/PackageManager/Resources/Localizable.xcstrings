        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查識別規則：%1$@"
          }
        }
      }
    },
    "adapter.error.compiledFormat": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル済みの入力パックファイルの形式が正しくありません：%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案编译文件格式不正确：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方案編譯檔案格式不正確：%1$@"
          }
        }
      }
    },
    "adapter.error.compiledIdentity": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル済みファイルの入力パック識別子が一致しません：%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案编译文件的方案标识不符：%1$@"
