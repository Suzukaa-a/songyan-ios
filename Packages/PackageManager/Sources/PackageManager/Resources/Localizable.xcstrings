        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案编译文件不是 UTF-8 编码：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方案編譯檔案不是 UTF-8 編碼：%1$@"
          }
        }
      }
    },
    "adapter.error.compiledTooLarge": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル済みの入力パックファイルがサイズ上限を超えています：%1$@（%2$ld バイト）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案编译文件超过大小限制：%1$@（%2$ld 字节）"
