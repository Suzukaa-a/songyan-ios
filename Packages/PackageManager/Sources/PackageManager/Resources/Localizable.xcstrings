        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方案編譯檔案缺少主轉換器配置或詞典：%1$@"
          }
        }
      }
    },
    "adapter.error.compiledNotUTF8": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル済みの入力パックファイルが UTF-8 ではありません：%1$@"
          }
