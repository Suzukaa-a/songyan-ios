        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方案編譯檔案的方案標識不符：%1$@"
          }
        }
      }
    },
    "adapter.error.compiledIncomplete": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル済みファイルにメイン変換器の設定または辞書がありません：%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案编译文件缺少主转换器配置或词典：%1$@"
