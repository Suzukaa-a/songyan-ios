    "delete.error.invalidTarget": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除する入力パックを確認できませんでした。何も変更していません。一覧に戻ってからやり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认要删除的输入方案，未作任何更改。请返回列表后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認要刪除的輸入方案，未作任何更改。請返回列表後重試。"
          }
        }
      }
    },
    "delete.error.moveFailed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除が完了しませんでした。一覧に戻って確認してから、もう一度操作してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除未完成。请返回列表核对后再操作。"
