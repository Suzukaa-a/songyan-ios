    "delete.error.trashUnavailable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はこの入力パックを削除できません。何も変更していません。しばらくしてからやり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法删除这个输入方案，未作任何更改。请稍后重试。"
