{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "appearance.name.systemDefault": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统默认"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの既定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統預設"
          }
        }
      }
    },
