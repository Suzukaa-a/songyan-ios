{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "tool.error.fileTooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is larger than the %1$@ KB limit. Choose another tool file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎます（上限は %1$@ KB）。別のツールファイルを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件超过 %1$@ KB 的上限，请换一个工具文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案超過 %1$@ KB 的上限，請換一個工具檔案。"
          }
        }
      }
    },
    "tool.error.invalidField": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file's \"%1$@\" value is invalid. Check it and import the file again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの「%1$@」が正しくありません。確認してから読み込み直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件里的「%1$@」写得不对，请检查后重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案裡的「%1$@」寫得不對，請檢查後重新匯入。"
          }
        }
      }
    },
    "tool.error.invalidRegex": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$@ has an invalid match rule. Check it and import the file again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ %1$@ の置換ルールが正しくありません。確認してから読み込み直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$@ 步的匹配规则写错了，请检查后重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$@ 步的比對規則寫錯了，請檢查後重新匯入。"
          }
        }
      }
    },
    "tool.error.missingField": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is missing \"%1$@\". Add it and import the file again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに「%1$@」がありません。追加してから読み込み直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件里缺少「%1$@」这一项，请补上后重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案裡缺少「%1$@」這一項，請補上後重新匯入。"
          }
        }
      }
    },
    "tool.error.noSteps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tool has no steps. Add at least one step before importing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツールにはステップがありません。1 つ以上追加してから読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个工具没有任何步骤，请至少加一步再导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工具沒有任何步驟，請至少加一步再匯入。"
          }
        }
      }
    },
    "tool.error.notAFile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This location isn't a file. Choose a file and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所はファイルではありません。ファイルを選び直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个位置不是文件，请重新选择文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個位置不是檔案，請重新選擇檔案。"
          }
        }
      }
    },
    "tool.error.tooManySteps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tool has %1$@ steps, more than the %2$@-step limit. Merge or remove some steps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツールは %1$@ ステップあり、上限の %2$@ ステップを超えています。まとめるか削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个工具有 %1$@ 步，超过了 %2$@ 步的上限，请合并或删掉一些步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工具有 %1$@ 步，超過 %2$@ 步的上限，請合併或刪掉一些步驟。"
          }
        }
      }
    },
    "tool.error.unavailableOpenCCConfig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$@ uses the conversion \"%2$@\", which isn't available. Use a conversion that comes with the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ %1$@ の変換方法「%2$@」は使えません。アプリに組み込まれた変換方法に変えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$@ 步的转换方式「%2$@」不可用，请换成 App 自带的转换方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$@ 步的轉換方式「%2$@」無法使用，請換成 App 內建的轉換方式。"
          }
        }
      }
    },
    "tool.error.unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a tool file. Export or download it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはツールファイルとして読み取れません。もう一度書き出すか、ダウンロードし直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件不是工具文件，请重新导出或下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案不是工具檔案，請重新匯出或下載。"
          }
        }
      }
    },
    "tool.error.unsupportedFormatVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tool file uses format version %1$@, which this version of the app can't open. Update the app and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツールファイルはバージョン %1$@ の形式です。このバージョンのアプリでは開けないため、アプリを更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个工具文件是 %1$@ 版格式，当前版本打不开，请更新 App 后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工具檔案是 %1$@ 版格式，目前的版本打不開，請更新 App 之後再試。"
          }
        }
      }
    },
    "tool.error.unsupportedStepType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$@ has the unknown type \"%2$@\". Replace it with a supported step and import again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ %1$@ の種類「%2$@」は使えません。対応しているステップに変えてから読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$@ 步的类型「%2$@」不认识，请换成支持的步骤再导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$@ 步的類型「%2$@」不認得，請換成支援的步驟再匯入。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
