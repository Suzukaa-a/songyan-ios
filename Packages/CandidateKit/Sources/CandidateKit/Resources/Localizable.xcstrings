{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "candidate.name.systemDefault": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统默认"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの既定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統預設"
          }
        }
      }
    },
    "candidate.name.copySuffix": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 副本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のコピー"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 副本"
          }
        }
      }
    },
    "candidate.error.fileTooLarge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选栏文件超过 128KB，请删掉一些内容后再试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補列ファイルが 128KB を超えています。内容を減らしてからもう一度お試しください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選列檔案超過 128KB，請刪掉一些內容後再試。"
          }
        }
      }
    },
    "candidate.error.notAnObject": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选栏文件的内容无法读取，请检查文件后再试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補列ファイルの内容を読み取れません。ファイルを確認してからもう一度お試しください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選列檔案的內容無法讀取，請檢查檔案後再試。"
          }
        }
      }
    },
    "candidate.error.unknownField": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选栏文件里有不支持的字段「%1$@」（%2$@），请检查文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補列ファイルに未対応の項目「%1$@」があります（%2$@）。ファイルを確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選列檔案裡有不支援的欄位「%1$@」（%2$@），請檢查檔案。"
          }
        }
      }
    },
    "candidate.error.unsupportedVersion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只支持版本 %1$@ 的候选栏文件，请检查文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応している候補列ファイルのバージョンは %1$@ だけです。ファイルを確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只支援版本 %1$@ 的候選列檔案，請檢查檔案。"
          }
        }
      }
    },
    "candidate.error.invalidValue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选栏文件里有一项值无效（%1$@），请检查文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補列ファイルの値が正しくありません（%1$@）。ファイルを確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選列檔案裡有一項值無效（%1$@），請檢查檔案。"
          }
        }
      }
    },
    "candidate.ambiguity.truncated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拼音组合没有全部列出，暂时无法锁定组合。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンインの組み合わせが多すぎてすべて表示できません。今は組み合わせを固定できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拼音組合沒有全部列出，暫時無法鎖定組合。"
          }
        }
      }
    },
    "candidate.reading.accessibilityTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读音"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀音"
          }
        }
      }
    },
    "candidate.reading.lockOption": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定组合 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み合わせ「%1$@」を固定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定組合 %1$@"
          }
        }
      }
    },
    "candidate.reading.lockedOption": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定组合 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み合わせ「%1$@」を固定しました"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已鎖定組合 %1$@"
          }
        }
      }
    },
    "candidate.reading.undoLockHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按删除键撤销组合"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除キーで組み合わせを解除できます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按刪除鍵撤銷組合"
          }
        }
      }
    },
    "candidate.reading.selectedReadings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选读音 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した読み「%1$@」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選讀音 %1$@"
          }
        }
      }
    },
    "candidate.reading.undoReadingHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按删除键取消上一音节"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除キーで前の音節を取り消せます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按刪除鍵取消上一音節"
          }
        }
      }
    },
    "candidate.reading.chooseReading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择读音 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み「%1$@」を選ぶ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇讀音 %1$@"
          }
        }
      }
    },
    "candidate.control.loadEarlier": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更早候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の候補を読み込む"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入更早候選"
          }
        }
      }
    },
    "candidate.control.loadMore": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更多候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに候補を読み込む"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入更多候選"
          }
        }
      }
    },
    "candidate.control.retryLoadEarlier": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试加载更早候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の候補の読み込みをやり直す"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試載入更早候選"
          }
        }
      }
    },
    "candidate.control.retryLoad": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试加载候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補の読み込みをやり直す"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試載入候選"
          }
        }
      }
    },
    "candidate.control.collapse": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補を閉じる"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起候選"
          }
        }
      }
    },
    "candidate.control.expand": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補を広げる"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開候選"
          }
        }
      }
    },
    "candidate.header.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選"
          }
        }
      }
    },
    "candidate.header.composingHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续输入，或按回车确认"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力を続けるか、Return キーで確定します"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續輸入，或按回車確認"
          }
        }
      }
    },
    "candidate.accessibility.list": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选列表"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補リスト"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選列表"
          }
        }
      }
    },
    "candidate.accessibility.listMore": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选列表，滚动可加载更多"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補リスト。スクロールするとさらに読み込めます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選列表，滾動可載入更多"
          }
        }
      }
    },
    "candidate.accessibility.commitHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上屏此候选"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この候補を入力します"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上屏此候選"
          }
        }
      }
    },
    "candidate.accessibility.selectKey": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选词键 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択キー %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選詞鍵 %1$@"
          }
        }
      }
    }
  },
  "version": "1.0"
}