{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "layout.error.kanaRow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假名键只能填一个假名行，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "假名鍵只能填一個假名行，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かなキーには、かな行を 1 つだけ指定できます。選び直してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A kana key can name only one kana row. Choose the row again."
          }
        }
      }
    },
    "layout.error.asciiOnlyLiteral": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有文字键可以同时填写英文符号，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有文字鍵可以同時填寫英文符號，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字記号を入力できるのは文字キーだけです。選び直してください。"
          }
        }
      }
    },
    "layout.error.codeValue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入字母的按键只能填一个英文字母、数字或符号，请修改后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入字母的按鍵只能填一個英文字母、數字或符號，請修改後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字を入力するキーには、英字・数字・記号のいずれか 1 文字だけを指定してください。修正してから保存してください。"
          }
        }
      }
    },
    "layout.error.literalEmpty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写按键要输入的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫按鍵要輸入的文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーで入力する文字を入力してください。"
          }
        }
      }
    },
    "layout.error.asciiValueEmpty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "英文符号不能为空，请重新填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "英文符號不能為空，請重新填寫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字記号を空にはできません。入力し直してください。"
          }
        }
      }
    },
    "layout.error.modeSwitchValue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换布局键的设置无法识别，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換佈局鍵的設定無法識別，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配列を切り替えるキーの設定を認識できません。選び直してください。"
          }
        }
      }
    },
    "layout.error.pageSwitchTarget": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻页键只能选择字母、数字或符号页，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻頁鍵只能選擇字母、數字或符號頁，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ切り替えキーは、英字・数字・記号ページから選んでください。"
          }
        }
      }
    },
    "layout.error.pageJumpTarget": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳转键只能选择 26 键、14 键、18 键或 9 键的数字页或符号页，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跳轉鍵只能選擇 26 鍵、14 鍵、18 鍵或 9 鍵的數字頁或符號頁，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャンプキーは、26 キー・14 キー・18 キー・9 キーの数字ページまたは記号ページから選んでください。"
          }
        }
      }
    },
    "layout.error.languageSwitchValue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中英键的行为无法识别，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中英鍵的行為無法識別，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中英キーの動作を認識できません。選び直してください。"
          }
        }
      }
    },
    "layout.error.functionKeyValue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个功能键不需要填写输入的文字，请清空后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個功能鍵不需要填寫輸入的文字，請清空後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファンクションキーには入力する文字を指定しません。空にしてから保存してください。"
          }
        }
      }
    },
    "layout.error.fileTooLarge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局文件过大，请删掉一些按键或文字后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佈局檔案過大，請刪掉一些按鍵或文字後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配列ファイルが大きすぎます。キーや文字を減らしてからもう一度お試しください。"
          }
        }
      }
    },
    "layout.error.t9OnlySettings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首键与快捷符号设置只适用于九键布局，请移除后再导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首鍵與快捷符號設定只適用於九鍵佈局，請移除後再匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭キーとクイック記号の設定は 9 キー配列だけで使えます。削除してから読み込んでください。"
          }
        }
      }
    },
    "layout.error.quickSymbols": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷符号最多填写 12 个，不能重复或包含空白，请修改后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷符號最多填寫 12 個，不能重複或包含空白，請修改後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック記号は 12 個までです。重複や空白は使えません。修正してから保存してください。"
          }
        }
      }
    },
    "layout.error.longPressDelay": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按等待时间要大于 0 秒，请修改后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按等待時間要大於 0 秒，請修改後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しの待ち時間は 0 秒より大きくしてください。修正してから保存してください。"
          }
        }
      }
    },
    "layout.error.missingName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写名称后再保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫名稱後再儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を入力してから保存してください。"
          }
        }
      }
    },
    "layout.error.emptySchema": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个布局指定的输入方案是空的，请重新选择输入方案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個佈局指定的輸入方案是空的，請重新選擇輸入方案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この配列に指定された入力パックが空です。入力パックを選び直してください。"
          }
        }
      }
    },
    "layout.error.missingTarget": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择这个布局适用的输入方案，或者适用的键盘（如 26 键、9 键）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇這個佈局適用的輸入方案，或者適用的鍵盤（如 26 鍵、9 鍵）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この配列で使う入力パック、またはキーボード（26 キー・9 キーなど）を選んでください。"
          }
        }
      }
    },
    "layout.error.noRows": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少保留一行，每行至少保留一个按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請至少保留一行，每行至少保留一個按鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行を 1 行以上、各キーを 1 つ以上残してください。"
          }
        }
      }
    },
    "layout.error.readingNeedsCandidates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拼音提示行需要显示候选栏，请开启后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拼音提示行需要顯示候選列，請開啟後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンインのヒント行には候補バーが必要です。オンにしてから保存してください。"
          }
        }
      }
    },
    "layout.error.phoneReadingSide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "9 键的拼音显示在左侧栏，请关闭拼音提示行后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "9 鍵的拼音顯示在左側欄，請關閉拼音提示行後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9 キーのピンインは左側の欄に表示されます。ピンインのヒント行をオフにしてから保存してください。"
          }
        }
      }
    },
    "layout.error.engineKeysNeedCandidates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入字母的按键需要显示候选栏，请开启后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入字母的按鍵需要顯示候選列，請開啟後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字を入力するキーには候補バーが必要です。オンにしてから保存してください。"
          }
        }
      }
    },
    "layout.error.disambiguationKeys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选字辅助区的按键由输入法自动提供，请清空其中的按键后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選字輔助區的按鍵由輸入法自動提供，請清空其中的按鍵後儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択補助エリアのキーは入力方式が自動で用意します。キーを空にしてから保存してください。"
          }
        }
      }
    },
    "layout.error.keyTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写按键标题，并把宽度设为大于 0 的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫按鍵標題，並把寬度設為大於 0 的數字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのタイトルを入力し、幅を 0 より大きい数にしてください。"
          }
        }
      }
    },
    "layout.error.optionTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写长按项的标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫長按項的標題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押し項目のタイトルを入力してください。"
          }
        }
      }
    },
    "layout.error.duplicateID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经有一个相同的键盘布局，请选择替换，或者另存为副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經有一個相同的鍵盤配置，請選擇取代，或者另存為副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じキーボード配列がすでにあります。置き換えるか、別名で複製してください。"
          }
        }
      }
    },
    "layout.error.unknownID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到这个键盘布局，它可能已经被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到這個鍵盤配置，它可能已經被刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーボード配列が見つかりません。削除された可能性があります。"
          }
        }
      }
    },
    "layout.error.copySuffix": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 副本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 副本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のコピー"
          }
        }
      }
    },
    "page.error.only123Presentation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 123 页可以选择「自动」或「数字九宫格」，请重新选择页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 123 頁可以選擇「自動」或「數字九宮格」，請重新選擇頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "123 ページで選べるのは「自動」か「数字キーパッド」だけです。ページを選び直してください。"
          }
        }
      }
    },
    "page.error.categoriesOnlySymbols": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类浏览只适用于符号页，请重新选择页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分類瀏覽只適用於符號頁，請重新選擇頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類して表示できるのは記号ページだけです。ページを選び直してください。"
          }
        }
      }
    },
    "page.error.autoNumericPlain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动 123」不能带按键或分类，请复制一份再编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動 123」不能帶按鍵或分類，請複製一份再編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動 123」にはキーや分類を追加できません。複製してから編集してください。"
          }
        }
      }
    },
    "page.error.categorizedLeading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类符号页的左侧栏由分类决定，不能再放按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分類符號頁的左側欄由分類決定，不能再放按鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類付きの記号ページでは、左側の欄は分類で決まります。キーは追加できません。"
          }
        }
      }
    },
    "page.error.oneCategory": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少保留一个分类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請至少保留一個分類。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類を 1 つ以上残してください。"
          }
        }
      }
    },
    "page.error.duplicateCategory": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有两个分类重复了，请删掉其中一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有兩個分類重複了，請刪掉其中一個。"
          }
        },
        "ja": {
