    "layout.note.merged14": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个字母合用一个键，轻点输入。输入方案支持时，向左或向右滑动可只输入左边或右边的字母。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 つの英字を 1 つのキーで入力します。入力方式が対応している場合、左右にスワイプすると片方の英字だけを入力できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個字母合用一個鍵，點一下輸入。輸入方案支援時，向左或向右滑動可只輸入左邊或右邊的字母。"
          }
        }
      }
    },
    "layout.note.merged18": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分键由两个字母合用，轻点输入。输入方案支持时，向左或向右滑动可只输入左边或右边的字母。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のキーは 2 つの英字を兼ねます。入力方式が対応している場合、左右にスワイプすると片方の英字だけを入力できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分鍵由兩個字母合用，點一下輸入。輸入方案支援時，向左或向右滑動可只輸入左邊或右邊的字母。"
          }
        }
      }
    },
    "layout.note.phone9": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2–9 键按所选的输入方案输入。输入中轻点首键可分词；未输入时，左栏前三个符号可直接输入，连续点按首键可轮换其余符号。长按首键输入 1，长按 2–9 输入对应数字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2〜9 キーは選択した入力方式で入力します。入力中に先頭キーをタップすると区切りを入れます。未入力時は左側の 3 つの記号を直接入力でき、先頭キーを続けてタップするとほかの記号に切り替わります。先頭キーの長押しで 1、2〜9 の長押しで対応する数字を入力します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2–9 鍵按所選的輸入方案輸入。輸入中點一下首鍵可分詞；未輸入時，左欄前三個符號可直接輸入，連續輕觸首鍵可輪換其餘符號。長按首鍵輸入 1，長按 2–9 輸入對應數字。"
          }
        }
      }
    },
